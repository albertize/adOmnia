{
  "$schema": "../../schemas/manifest-v2.schema.json",
  "manifestVersion": 2,
  "id": "adomnia.database-runner-example",
  "name": "Database Runner Example",
  "version": "1.0.0",
  "publisher": "adomnia",
  "description": "Runs a cancellable query through an existing adOmnia database connection.",
  "license": "MIT",
  "engines": { "adomnia": ">=0.9.0 <2" },
  "apiVersion": "2.0",
  "main": "extension.js",
  "activationEvents": ["onCommand:adomnia.database-runner-example.query", "onDatabaseComplete", "onView:adomnia.database-runner-example.results"],
  "permissions": ["databases.execute"],
  "contributes": {
    "commands": [{ "id": "adomnia.database-runner-example.query", "title": "Run database query", "category": "Database" }],
    "views": [{ "id": "adomnia.database-runner-example.results", "container": "flow-analysis", "name": "Database Job Results", "renderer": "declarative" }]
  }
}
