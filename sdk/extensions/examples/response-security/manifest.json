{
  "$schema": "../../schemas/manifest-v2.schema.json",
  "manifestVersion": 2,
  "id": "adomnia.response-security-example",
  "name": "Response Security Example",
  "version": "1.0.0",
  "publisher": "adomnia",
  "description": "Analyzes response security headers in a native response tab.",
  "license": "MIT",
  "engines": { "adomnia": ">=0.9.0 <2" },
  "apiVersion": "2.0",
  "main": "extension.js",
  "activationEvents": ["onResponse"],
  "permissions": ["responses.read"],
  "contributes": {
    "views": [{ "id": "adomnia.response-security-example.results", "container": "response", "name": "Security", "renderer": "declarative", "when": "hasResponse" }]
  }
}
