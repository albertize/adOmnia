{
  "$schema": "https://adomnia.local/schemas/extension-manifest-v2.json",
  "manifestVersion": 2,
  "id": "{{ID}}",
  "name": "{{NAME}}",
  "version": "0.1.0",
  "publisher": "{{PUBLISHER}}",
  "description": "An adOmnia response-analysis extension.",
  "license": "MIT",
  "engines": { "adomnia": ">=1.0.0 <2" },
  "apiVersion": "2.0",
  "main": "src/extension.js",
  "activationEvents": ["onResponse", "onCommand:{{ID}}.inspect"],
  "permissions": ["responses.read", "notifications"],
  "contributes": {
    "commands": [
      { "id": "{{ID}}.inspect", "title": "Inspect Active Response", "category": "{{NAME}}" }
    ]
  }
}
