{
  "$schema": "https://adomnia.local/schemas/extension-manifest-v2.json",
  "manifestVersion": 2,
  "id": "{{ID}}",
  "name": "{{NAME}}",
  "version": "0.1.0",
  "publisher": "{{PUBLISHER}}",
  "description": "An adOmnia extension with a declarative view.",
  "license": "MIT",
  "engines": { "adomnia": ">=1.0.0 <2" },
  "apiVersion": "2.0",
  "main": "src/extension.js",
  "activationEvents": ["onView:{{ID}}.results", "onCommand:{{ID}}.refresh"],
  "permissions": ["workspaceState"],
  "contributes": {
    "commands": [
      { "id": "{{ID}}.refresh", "title": "Refresh Results", "category": "{{NAME}}" }
    ],
    "views": [
      { "id": "{{ID}}.results", "container": "analysis", "name": "{{NAME}}", "renderer": "declarative" }
    ]
  }
}
