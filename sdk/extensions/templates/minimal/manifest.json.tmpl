{
  "$schema": "https://adomnia.local/schemas/extension-manifest-v2.json",
  "manifestVersion": 2,
  "id": "{{ID}}",
  "name": "{{NAME}}",
  "version": "0.1.0",
  "publisher": "{{PUBLISHER}}",
  "description": "A local adOmnia extension.",
  "license": "MIT",
  "engines": { "adomnia": ">=1.0.0 <2" },
  "apiVersion": "2.0",
  "main": "src/extension.js",
  "activationEvents": ["onCommand:{{ID}}.hello"],
  "permissions": ["notifications"],
  "contributes": {
    "commands": [
      { "id": "{{ID}}.hello", "title": "Say Hello", "category": "{{NAME}}" }
    ]
  }
}
